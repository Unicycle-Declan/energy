url <- 'https://nyc3.digitaloceanspaces.com/owid-public/data/co2/owid-co2-data.csv'
carbon <-
read_csv(url)
#carbon %>% head
#View(carbon)
url <- 'https://raw.githubusercontent.com/ericmkeen/sewanee_esus/master/02_energy_sector/levelized-cost-of-energy.csv'
econ <- read_csv(url)
#econ %>% head()
#View(econ)
ggplot(econ,
aes(x = year,
y = cost,
color = source)
) +
geom_point() +
geom_hline(yintercept = 0.05, lty = 2) +
geom_hline(yintercept = 0.18, lty = 2) +
annotate(geom= 'text',
x=1990, 0.1, size = 5, label = 'Range of fossil\n fule costs')
econ%>%
filter(year == 2020) %>%
group_by(source) %>%
summarize(cost = mean(cost, na.rm = TRUE)) %>%
kable
## join for continents
energy <- energy %>%
rename(country=`Country/area`, year = Year)
View(energy)
energy <-
left_join(energy, gapminder, by = c(country, year))
