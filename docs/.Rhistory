food_co2 <- read_csv(url)
food_co2 %>% head
food_co2 %>%
filter(entity == 'United States',
year %in% c(1770:2023))
(food_co2 %>%
filter(entity == 'United States',
year %in% c(1770:2023))
)
(food_co2 %>%
filter(entity == 'United States',
year %in% c(1770:2023)) %>%
rename(food_emissions = greenhouse_gas_emissions_from_food)
)
(USfood_co2 <-
food_co2 %>%
filter(entity == 'United States',
year %in% c(1770:2023)) %>%
rename(food_emissions = greenhouse_gas_emissions_from_food)
)
ggplot(USfood_co2,
aes(x = year,
y = food_emissions))
ggplot(USfood_co2,
aes(x = year,
y = food_emissions)) +
geom_path()
