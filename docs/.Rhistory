install.packages("purrr")
install.packages("purrr")
library(purrr)
`%not_in%` <- negate(`%in%`)
food_producers <- read_csv(url) %>%
filter(entity %not_in% c("World",
"North America",
"South America",
"Africa",
"Asia",
"Ociana",
"Europe") )
View(food_producers)
#View(food_producers)
food_producers %>%
entity %>%
pull(uneque_values)
#View(food_producers)
food_producers %>%
pull(entity) %>%
pull(uneque_values)
#View(food_producers)
food_producers %>%
pull(entity) %>%
uneque()
#View(food_producers)
food_producers %>%
pull(entity) %>%
unique()
filtered_data <- food_producers %>%
filter(grepl("\\(FA0\\)$", entity))
filtered_data
View(filtered_data)
filtered_data <- food_producers %>%
filter(grepl("\\(FAO\\)$", entity))
View(filtered_data)
filtered_data <- food_producers %>%
filter(!grepl("\\(FAO\\)$", entity))
View(filtered_data)
`%not_in%` <- negate(`%in%`)
food_producers <- read_csv(url) %>%
filter(entity %not_in% c("World",
"North America",
"South America",
"Africa",
"Asia",
"Ociana",
"Europe"),
!grepl("\\(FAO\\)$", entity))
#View(food_producers)
food_producers %>%
pull(entity) %>%
unique()
ggplot(food_producers,
aes(x = year,
y = maize__00000056__production__005510__tonnes)
) +
geom_path()
