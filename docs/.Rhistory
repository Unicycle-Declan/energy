#gapminder %>% head
#View(gapminder)
url <- 'https://nyc3.digitaloceanspaces.com/owid-public/data/co2/owid-co2-data.csv'
carbon <-
read_csv(url)
#carbon %>% head
#View(carbon)
url <- 'https://raw.githubusercontent.com/ericmkeen/sewanee_esus/master/02_energy_sector/levelized-cost-of-energy.csv'
econ <-
read_csv(url)
#econ %>% head()
#View(econ)
econ%>%
filter(year == 2020) %>%
group_by(source) %>%
summarize(cost = mean(cost, na.rm = TRUE)) %>%
kable
# Create summary data
fig_1_data <- gapminder %>%
group_by(year) %>%
summarize(
mean_lifeExp = mean(lifeExp, na.rm = TRUE),
mean_gdpPercap = mean(gdpPercap, na.rm = TRUE),
.groups = "drop"
)
# Calculate scale factor
scale_factor <- max(fig_1_data$mean_gdpPercap) / (max(fig_1_data$mean_lifeExp) + 10)
# Make graph
ggplot(fig_1_data, aes(x = year)) +
geom_path(aes(y = mean_lifeExp),
color = "green",
size = 1) +
geom_path(aes(y = mean_gdpPercap / scale_factor),
color = "orange",
size = 1) +
scale_y_continuous(
name = "Mean Life Expectancy (green)",
sec.axis = sec_axis(
~ . * scale_factor,
name = "Mean GDP Per Capita in USD (orange)"
)
) +
labs(
title = "Human Progress",
subtitle = "Advances in human standard of living since 1950",
x = " "
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold", size = 14),
axis.title = element_text(size = 11)
)
