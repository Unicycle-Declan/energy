#Install Packages ----
#install.packages("rstudioapi")
library(rstudioapi)
#install.packages("readr")
library(readr)
#install.packages("plotly")
library(plotly)
#install.packages("ggplot2")
library(ggplot2)
#install.packages("dplyr")
library(dplyr)
#install.packages("tidyr")
library(tidyr)
url <- 'https://nyc3.digitaloceanspaces.com/owid-public/data/co2/owid-co2-data.csv'
carbon <-
read_csv(url) %>%
select(country,
year,
pop = population,
gdp,
co2,
hist_co2 = cumulative_co2)
# Explore data ----
View(carbon)
nrow(carbon)
ncol(carbon)
head(carbon)
tail(carbon)
carbon %>% pull(year) %>% range()
# make plots ----
carbon_filt <- carbon %>%
filter(country %in% c('United States', 'China', 'India', 'Japan', 'Germany'))
View(carbon_filt)
## annual CO2 emission trends ----
ggplot(carbon_filt,
aes(x = year,
y = co2,
colour = country)) +
geom_path(size = 2, alpha = .9) +
labs(title = "Annual CO2 Emission Trends",
subtitle = "CO2 in millions of metric tons")
## Cumulative CO2 ----
carbon_trans <- carbon_filt %>%
mutate(hist_co2 = hist_co2 / 1000)
View(carbon_trans)
ggplot(carbon_trans,
aes(x = year,
y = hist_co2,
color = country)) +
geom_path(size = 2) +
labs( title = 'Total CO2 Emisions',
y = 'Toal CO2 (in thousands of tons)'
)
## Per-capita emissions ----
carbon_mutate <-
carbon_filt %>%
mutate(co2 = co2 * 1000000) %>%
mutate(co2_percap = co2 / pop)
ggplot(carbon_mutate,
aes(x= year,
y= co2_percap,
color = country)) +
geom_path( size = 1.5) +
labs(title = 'CO2 Per-capita',
x = 'Year',
y = 'CO2 Per-capita (in millions of tons)')
## Table ----
summery_table <-
carbon_filt %>%
group_by(country) %>%
summarise(
'Mean CO2' = mean(co2, na.rm = TRUE),
'max CO2' = max(hist_co2, na.rm = TRUE)
)
print(summery_table)
## Bar Graph ----
ggplot(carbon_filt,
aes(x = country,
y = (sum(co2, na.rm = TRUE) / 1000000),
fill = country)
) +
geom_col() +
labs( title = 'Total CO2 Emissions',
subtitle = 'CO2 in millions of tons',
caption = 'Data from 1750 to 2023',
x = '',
y = 'CO2')
